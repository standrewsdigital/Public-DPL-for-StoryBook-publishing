{
  "type": "module",
  "name": "@stadigicomms/dpl",
  "version": "1.4.2",
  "description": "the css library for the sta website",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "scss:watch": "sass --watch --style=compressed scss-styles/:compiled-css/",
    "scss:build": "sass --style=compressed scss-styles/:compiled-css/",
    "dev": "npm run scss:watch",
    "build": "npm run scss:build && npm run build-vite",
