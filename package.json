    "ssh2-sftp-client": "^10.0.0",
    "vite": "^6.2.1",
    "vite-plugin-list-directory-contents": "^1.4.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "babel-loader": "^9.1.3"
  }
